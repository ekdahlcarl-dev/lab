# PostgreSQL persistence (required for durable orders/payments outside tests).
DATABASE_URL=postgresql://lab:lab@localhost:5432/lab

# Default local/test payment mode uses the mock Swish provider.
PAYMENT_MODE=mock

# Real Swish mode. Do not commit real credentials/certificates.
# PAYMENT_MODE=swish
# SWISH_API_URL=https://mss.cpc.getswish.net/swish-cpcapi/api/v2
# SWISH_CALLBACK_URL=https://your-public-host.example/api/payment/callback
# SWISH_PAYEE_ALIAS=1231181189

# Real Swish requires mutual-TLS client certificate configuration in the
# deployment/runtime HTTP stack. Keep certificate material outside Git.
